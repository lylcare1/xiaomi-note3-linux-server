+			/*
+			 * CPR3 nvmem cells for qcom,sdm630-cprh (PLACEHOLDER).
+			 *
+			 * WARNING: These offsets are copied from MSM8998 (msm8998-angelo.dtsi)
+			 * and have NOT been verified against SDM630/SDM660 real qfprom fuse
+			 * layout. MSM8998 and SDM630 qfprom differ (proven by qusb2_hstx_trim:
+			 * MSM8998 @ 0x23a, SDM630 @ 0x243). Using these offsets with
+			 * status="okay" would program invalid voltages and may damage the SoC.
+			 * The cprh node below is kept status="disabled" for safety.
+			 *
+			 * SDM630 CPR3 descriptor: gold (cpr0) = 5 fuse corners,
+			 * silver (cpr1) = 3 fuse corners. Naming: cpr{tid}_{field}{i}.
+			 */
+
+			/* Global CPR fuses */
