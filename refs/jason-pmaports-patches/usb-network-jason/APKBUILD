pkgname=usb-network-jason
pkgver=1.0.0
pkgrel=1
pkgdesc="USB network setup for Xiaomi Mi Note 3 (jason)"
url="https://github.com/lylcare1/XiaoMiNote3"
arch="aarch64"
license="MIT"
depends="dnsmasq iproute2"
source="
  setup-usb-gadget.sh
  setup-usb-gadget.service
  usb-ip-monitor.sh
  usb-ip-monitor.service
  10-usb0.link
  99-usb0-unmanaged.conf
  override-time-wait-sync.conf
  journald-storage.conf
"
package() {
  install -Dm644 "$srcdir/setup-usb-gadget.service" "$pkgdir/etc/systemd/system/setup-usb-gadget.service"
  install -Dm644 "$srcdir/usb-ip-monitor.service" "$pkgdir/etc/systemd/system/usb-ip-monitor.service"
  install -Dm755 "$srcdir/setup-usb-gadget.sh" "$pkgdir/usr/bin/setup-usb-gadget.sh"
  install -Dm755 "$srcdir/usb-ip-monitor.sh" "$pkgdir/usr/bin/usb-ip-monitor.sh"
  install -Dm644 "$srcdir/10-usb0.link" "$pkgdir/etc/systemd/network/10-usb0.link"
  install -Dm644 "$srcdir/99-usb0-unmanaged.conf" "$pkgdir/etc/NetworkManager/conf.d/99-usb0-unmanaged.conf"
  install -Dm644 "$srcdir/override-time-wait-sync.conf" "$pkgdir/etc/systemd/system/systemd-time-wait-sync.service.d/override.conf"
  install -Dm644 "$srcdir/journald-storage.conf" "$pkgdir/etc/systemd/journald.conf.d/storage.conf"

  # Enable services (symlinks to systemd target.wants)
  mkdir -p "$pkgdir/etc/systemd/system/sysinit.target.wants"
  ln -sf ../setup-usb-gadget.service \
    "$pkgdir/etc/systemd/system/sysinit.target.wants/setup-usb-gadget.service"
  mkdir -p "$pkgdir/etc/systemd/system/multi-user.target.wants"
  ln -sf ../usb-ip-monitor.service \
    "$pkgdir/etc/systemd/system/multi-user.target.wants/usb-ip-monitor.service"
}
