# 对应设备 /etc/systemd/system/fsck-check.service
# 来源: docs/troubleshooting.md §7.8.3 (P0-3 eMMC 自动 fsck)
#
# 功能: 每周只读检查 rootfs (loop0p2), 不修复, 只报告.
# 说明: pmOS rootfs 在 mmcblk1p70 (userdata) 内的 ext4 镜像上, 通过 loop 设备
#       (/dev/loop0p2) 挂载. initramfs 不支持 fsck loop device, 此 timer 替代.
#
# 一次性设置 (需手动执行, 非 service 的一部分):
#   tune2fs -c 30 -i 7d /dev/loop0p2
#
# e2fsck -n 退出码: 0=无错误, 4=有错误未修复 (只读模式预期), 用 SuccessExitStatus 容忍.
# 查看: journalctl -u fsck-check

[Unit]
Description=eMMC read-only fsck check (/dev/loop0p2)
After=local-fs.target
ConditionPathExists=/dev/loop0p2

[Service]
Type=oneshot
User=root
ExecStart=/sbin/e2fsck -f -n /dev/loop0p2
# 容忍只读检查的退出码 (0=无错误, 1/2=已修复, 4=有错误未修复)
SuccessExitStatus=0 1 2 4
